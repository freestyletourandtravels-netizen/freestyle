# Public URL of the live site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.freestyletourandtravels.com

# ---- Lead storage (at least ONE must work, otherwise the form shows an error) ----
# 1) Local file storage (works on a VPS / any Node server with a writable disk).
#    Set LEADS_FILE_STORAGE=false on serverless hosts such as Vercel.
LEADS_FILE_STORAGE=true
LEADS_FILE_PATH=./data/leads.jsonl

# 2) Webhook (Google Apps Script -> Google Sheets, Zapier, Make, n8n, your CRM...)
#    Each lead is POSTed as JSON.
LEADS_WEBHOOK_URL=

# 3) Email notification via Resend (https://resend.com) - no SDK needed
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=Freestyletourandtravels@gmail.com
LEADS_FROM_EMAIL=Freestyle Website <leads@yourdomain.com>

# Token to view stored leads at /admin/leads (file storage only)
ADMIN_TOKEN=change-me-to-a-long-random-string
